# Anthropic API key (https://console.anthropic.com/ で発行)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 使用モデル（任意・未指定なら既定値）
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite ファイルの保存先（任意・絶対パスのみ有効。未指定なら ./data/coach.db）
# DATABASE_PATH=C:\data\coach.db

# --- 自社メール送信（SMTP）---
# MAIL_MODE: dry=送信せず記録のみ（既定） / test=MAIL_TEST_TO にだけ送る / live=リード宛に実送信
MAIL_MODE=dry
SMTP_HOST=smtp.example.co.jp
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=sales@example.co.jp
MAIL_FROM_NAME=メディアブレイン 営業担当
# MAIL_REPLY_TO=
# MAIL_TEST_TO=自分のアドレス
MAIL_DAILY_LIMIT=30
# 特定電子メール法の表示事項（会社名・住所・連絡先）。| で改行
MAIL_FOOTER=株式会社メディアブレイン|〒000-0000 住所をここに|TEL 000-0000-0000
